                            <button class="interested-btn">Interested</button>
                        </div>
                    </div>

                    <!-- Pet 4 -->
                    <div class="pet-card">
                        <img src="https://assets.elanco.com/8e0bf1c2-1ae4-001f-9257-f2be3c683fb1/fca42f04-2474-4302-a238-990c8aebfe8c/Siamese_cat_1110x740.jpg?w=3840&q=75&auto=format" alt="Luna - Siamese" class="pet-image">
