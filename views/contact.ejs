<%- include('partials/header')%>
        <main class="content-area">
            <section class="form-container">
                <h2>Give us a feedback</h2>
                <form action="#" method="post">
                    <label for="animal-type">What kind of animal you adopted? Cat or Dog:</label>
                    <select id="animal-type" name="animal-type">
                        <option>Cat</option>
                        <option>Dog</option>
                    </select>
                    
                    <label for="breed">Breed:</label>
                    <input type="text" id="breed" name="breed" required>
                    
                    <label for="comments">Comments:</label>
                    <textarea id="comments" name="comments" rows="5"></textarea>
                    
                    <button type="submit" class="submit-btn">Submit</button>
                    <button type="reset" class="clear-btn">Clear</button>
                </form>
            </section>
            <section class="about-us">
                <h2>About Us</h2>
                <p>We are a dedicated organization helping pets find loving homes. Our mission is to connect animals in need with caring families.</p>
                <br><br>
                <ul>
                    <li>phone number : (123) 456 7890</li>
                    <br>
                    <li>email: petadoption@sample.com</li>
                    <br>
                    <li>location: <a href="https://www.google.com/maps/@28.2155283,-177.3764627,3a,75y,141.22h,90t/data=!3m7!1e1!3m5!1suhCqNRjHF-gJLdn2_idzFw!2e0!6shttps:%2F%2Fstreetviewpixels-pa.googleapis.com%2Fv1%2Fthumbnail%3Fcb_client%3Dmaps_sv.tactile%26w%3D900%26h%3D600%26pitch%3D0%26panoid%3DuhCqNRjHF-gJLdn2_idzFw%26yaw%3D141.22331!7i13312!8i6656?entry=ttu&g_ep=EgoyMDI1MDIxMi4wIKXMDSoASAFQAw%3D%3D">view on google maps</a></li>
                    <br>
                    <li>postal code: A1B 2C3</li>
                </ul>
            </section>
        </main>

<%- include('partials/footer') %>
