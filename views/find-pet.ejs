<%- include('partials/header’) %>
        <main class="content-area">
            <div class="search-form-container">
                <h2>Find Your Perfect Pet</h2>
                <form id="pet-search-form">
                    <div class="form-group">
                        <label for="pet-type">Cat or Dog</label>
                        <select id="pet-type" name="pet-type" required>
                            <option value="">Select pet type</option>
                            <option value="cat">Cat</option>
                            <option value="dog">Dog</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="breed">Breed</label>
                        <select id="breed" name="breed">
                            <option value="">Doesn't matter</option>
                            <option value="mixed">Mixed Breed</option>
                            <option value="purebred">Purebred</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="age">Preferred Age</label>
                        <select id="age" name="age">
                            <option value="">Doesn't matter</option>
                            <option value="baby">Baby (0-1 year)</option>
                            <option value="young">Young (1-3 years)</option>
                            <option value="adult">Adult (3-8 years)</option>
                            <option value="senior">Senior (8+ years)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Gender</label>
                        <div class="radio-group">
                            <label class="radio-option">
                                <input type="radio" name="gender" value="any" checked>
                                Doesn't matter
                            </label>
                            <label class="radio-option">
                                <input type="radio" name="gender" value="male">
                                Male
                            </label>
                            <label class="radio-option">
                                <input type="radio" name="gender" value="female">
                                Female
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Gets along with</label>
                        <div class="checkbox-group">
                            <label class="checkbox-option">
                                <input type="checkbox" name="friendly-dogs">
                                Other dogs
                            </label>
                            <label class="checkbox-option">
                                <input type="checkbox" name="friendly-cats">
                                Other cats
                            </label>
                            <label class="checkbox-option">
                                <input type="checkbox" name="friendly-children">
                                Small children
                            </label>
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="reset" class="clear-btn">Clear</button>
                        <button type="submit" class="submit-btn">Search</button>
                    </div>
                </form>
            </div>
        </main>
<%- include('partials/footer') %>